# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. Never prefix them with NEXT_PUBLIC_.

# Personal access token. Scopes: data.records:read, data.records:write, schema.bases:read.
# Grant access only to the Lead Pipeline base.
AIRTABLE_TOKEN=

# Lead Pipeline base and the Leads table. The app refuses any other table.
AIRTABLE_BASE_ID=app6E9VKmqQAaAu4j
LEADS_TABLE_ID=tbl8sXU8IpSP5fGHt

# Shared sales-team password, and the secret used to sign the session cookie.
# Use a long random SESSION_SECRET in production.
TEAM_PASSWORD=
SESSION_SECRET=

# Set to true to run the UI with sample leads and no Airtable calls.
# Leave empty or false in production. When this is true and TEAM_PASSWORD is
# empty, the demo password is: loyalist
# When SESSION_SECRET is empty in demo mode, a built-in demo secret is used.
DEMO_MODE=
